[Unit]
Description=CarLink wireless projection to wired CarLife bridge
Documentation=https://github.com/Aki894/CarLink
Wants=NetworkManager.service bluetooth.service
After=NetworkManager.service bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/carlink-run
Restart=on-failure
RestartSec=5s
TimeoutStopSec=25s
KillMode=control-group
RuntimeDirectory=carlink carlink-carplay
RuntimeDirectoryMode=0700
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/default/carlink
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
