+// CarLink uses a cross-process clock only in its headless live mode.
+fn carlink_clock_us(fallback: i64) -> i64 {
+    if std::env::var("CARLINK_LOW_LATENCY").as_deref() != Ok("1") { return fallback; }
+    let mut time = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut time) } != 0 { return fallback; }
+    time.tv_sec as i64 * 1_000_000 + time.tv_nsec as i64 / 1000
+}
+pub(crate) fn carlink_clock_message(offset:i64)->oxp_wire::Message {
+    oxp_wire::Message::Json(serde_json::json!({"type":"stats","screen":0,"decodeMs":null,"decodeQueue":0,"dropped":0,"rendered":0,"decodedLatencyMs":null,"renderedLatencyMs":null,"clockOffsetUs":offset,"rttUs":null}))
+}
+fn carlink_capture_us(sender_ns:u64, local_us:i64, anchor:&mut Option<(i64,i64)>) -> i64 {
+    if sender_ns==0 { return local_us; }
+    let remote=(sender_ns/1000) as i64;
+    let offset=local_us.saturating_sub(remote);
+    let best=anchor.map_or(offset,|(old,at)|old.saturating_add(local_us.saturating_sub(at).clamp(0,10_000_000)/10_000).min(offset));
+    *anchor=Some((best,local_us));
+    remote.saturating_add(best)
+}
+#[cfg(test)]
+#[test]
+fn carlink_capture_detects_delayed_sender_frames() {
+    oxp_wire::write(&mut Vec::new(),&carlink_clock_message(42)).expect("clock metadata must pass real OXP encoding");
+    let mut anchor=None;
+    assert_eq!(carlink_capture_us(1_000_000_000,10_000_000,&mut anchor),10_000_000);
+    assert!(12_000_000-carlink_capture_us(1_100_000_000,12_000_000,&mut anchor)>1_800_000);
+    assert_eq!(carlink_capture_us(3_100_000_000,12_100_000,&mut anchor),12_100_000);
+}
