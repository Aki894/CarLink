+#[cfg(test)]
+mod carlink_new_device_options_tests {
+    use super::*;
+    #[test]
+    fn carlink_new_device_flag_has_explicit_pairing_constraints() {
+        let root = std::env::temp_dir().join(format!("carlink-options-{}", crate::admin::auth::random_hex(8).unwrap()));
+        let parse = |args: &[&str]| { let mut all = vec!["--state-dir".into(), root.to_string_lossy().into_owned()]; all.extend(args.iter().map(|s| s.to_string())); Options::parse(&all) };
+        for args in [vec!["--new-device-only"], vec!["--pair", "30", "--new-device-only", "--iphone", "02:00:00:00:00:01"], vec!["--pair", "30", "--new-device-only", "--new-device-only"], vec!["--pair", "30", "--new-device-only", "--network-mode", "shared-wifi"]] {
+            assert!(parse(&args).is_err());
+        }
+        let adding = parse(&["--pair", "30", "--new-device-only"]).unwrap();
+        assert!(adding.new_device_only && adding.iphone.is_none());
+        let mut saved_default = adding.clone(); saved_default.settings.iphone = Some("02:00:00:00:00:01".into());
+        saved_default.apply_overrides().unwrap(); assert!(saved_default.iphone.is_none());
+        assert_eq!(saved_default.settings.iphone.as_deref(), Some("02:00:00:00:00:01"));
+        let repair = parse(&["--pair", "30", "--iphone", "02:00:00:00:00:01"]).unwrap();
+        assert!(!repair.new_device_only); assert_eq!(repair.iphone.as_deref(), Some("02:00:00:00:00:01"));
+        if root.exists() { std::fs::remove_dir_all(root).unwrap(); }
+    }
