+/// Frozen before the pairing window opens. Retries keep this snapshot and the
+/// first selected new target; they never promote an old bond or another phone.
+pub struct NewDeviceSelection {
+    excluded: std::collections::BTreeSet<String>,
+    selected: Option<String>,
+}
+impl NewDeviceSelection {
+    pub fn snapshot(devices: &[BondedDevice]) -> Self {
+        Self { excluded: devices.iter().filter(|d| d.paired).map(|d| d.address.to_ascii_uppercase()).collect(), selected: None }
+    }
+    pub fn select(&mut self, devices: &[BondedDevice]) -> Result<BondedDevice> {
+        if let Some(selected) = &self.selected { return select_iphone(devices, Some(selected)); }
+        let eligible: Vec<_> = devices.iter().filter(|d| !self.excluded.contains(&d.address.to_ascii_uppercase())).cloned().collect();
+        let selected = select_iphone(&eligible, None)?;
+        self.selected = Some(selected.address.clone());
+        Ok(selected)
+    }
+}
