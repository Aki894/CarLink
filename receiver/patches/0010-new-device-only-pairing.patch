+// New-device credentials are installed over the existing system D-Bus,
+// never as nmcli arguments or persistent normal hotspot credentials.
+fn ephemeral_ap_settings<'a>(id: &'a str, interface: &'a str, ssid: &'a str, password: &'a str,
+    band: &'a str, channel: u32, subnet: &str,
+) -> Result<std::collections::HashMap<&'static str, std::collections::HashMap<&'static str, zbus::zvariant::Value<'a>>>> {
+    use std::collections::HashMap;
+    use zbus::zvariant::Value;
+    let invalid = || std::io::Error::other("Invalid ephemeral hotspot settings");
+    validate_hotspot_credentials(ssid, password).map_err(|_| invalid())?;
+    let (address, prefix) = subnet.split_once('/').ok_or_else(invalid)?;
+    let address: Ipv4Addr = address.parse().map_err(|_| invalid())?;
+    let prefix: u32 = prefix.parse().map_err(|_| invalid())?;
+    if prefix > 32 || !matches!(band, "a" | "bg") || channel == 0 { return Err(invalid()); }
+    let hex = crate::admin::auth::random_hex(16)?;
+    let uuid = format!("{}-{}-{}-{}-{}", &hex[..8], &hex[8..12], &hex[12..16], &hex[16..20], &hex[20..]);
+    Ok(HashMap::from([
+        ("connection", HashMap::from([
+            ("id", Value::from(id)), ("uuid", Value::from(uuid)),
+            ("type", Value::from("802-11-wireless")), ("interface-name", Value::from(interface)),
+            ("autoconnect", Value::from(false)),
+        ])),
+        ("802-11-wireless", HashMap::from([
+            ("ssid", Value::from(ssid.as_bytes().to_vec())), ("mode", Value::from("ap")),
+            ("band", Value::from(band)), ("channel", Value::from(channel)),
+        ])),
+        ("802-11-wireless-security", HashMap::from([
+            ("key-mgmt", Value::from("wpa-psk")), ("psk", Value::from(password)),
+            ("proto", Value::from(vec!["rsn"])), ("pairwise", Value::from(vec!["ccmp"])), ("group", Value::from(vec!["ccmp"])),
+        ])),
+        ("ipv4", HashMap::from([
+            ("method", Value::from("shared")),
+            ("addresses", Value::from(vec![vec![u32::from_ne_bytes(address.octets()), prefix, 0]])),
+        ])),
+        ("ipv6", HashMap::from([("method", Value::from("disabled"))])),
+    ]))
+}
+fn add_ephemeral_ap(id: &str, interface: &str, ssid: &str, password: &str, band: &str, channel: u32, subnet: &str) -> Result<()> {
+    let settings = ephemeral_ap_settings(id, interface, ssid, password, band, channel, subnet)?;
+    let failed = |_| std::io::Error::other("Ephemeral hotspot profile installation failed");
+    let connection = zbus::blocking::Connection::system().map_err(failed)?;
+    let proxy = zbus::blocking::Proxy::new(&connection, "org.freedesktop.NetworkManager", "/org/freedesktop/NetworkManager/Settings", "org.freedesktop.NetworkManager.Settings").map_err(failed)?;
+    let _: zbus::zvariant::OwnedObjectPath = proxy.call("AddConnectionUnsaved", &(settings,)).map_err(failed)?;
+    Ok(())
+}
