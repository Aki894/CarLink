+#[cfg(test)]
+mod carlink_source_tests {
+    use super::*;
+
+    #[test]
+    fn carlink_source_response_streams_exact_length() {
+        let path = std::env::temp_dir().join(format!("carlink-source-{}", auth::random_hex(8).unwrap()));
+        let file = fs::File::create(&path).unwrap();
+        file.set_len(5 * 1024 * 1024).unwrap();
+        drop(file);
+        let size = 5 * 1024 * 1024;
+        let response = Response {
+            status: 200,
+            headers: BTreeMap::new(),
+            body: Vec::new(),
+            source_file: Some((fs::File::open(&path).unwrap(), size)),
+        };
+        let mut output = Vec::new();
+        response.write(&mut output).unwrap();
+        let split = output.windows(4).position(|p| p == b"\r\n\r\n").unwrap() + 4;
+        assert_eq!(output.len() - split, size as usize);
+        assert!(String::from_utf8_lossy(&output[..split]).contains("Content-Length: 5242880"));
+        assert!(output[split..].iter().all(|b| *b == 0));
+        drop(response);
+        fs::remove_file(path).unwrap();
+    }
+}
