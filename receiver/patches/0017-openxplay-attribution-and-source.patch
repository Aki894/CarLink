     settings.plugins = None;
     assert_eq!(settings.arguments(), expected);
 }
+
+// CarLink modification, 2026-11-16: source offers stay public and bounded to one asset.
+#[test]
+fn carlink_source_offer_is_public_and_only_the_archive_bypasses_asset_limit() {
+    let dir = Temp::new();
+    let s = server(&dir.0);
+    fs::create_dir(dir.0.join("carlink-source")).unwrap();
+    let archive = dir.0.join("carlink-source/corresponding-source.tar.gz");
+    fs::File::create(&archive).unwrap().set_len(5 * 1024 * 1024).unwrap();
+    fs::copy(&archive, dir.0.join("large.js")).unwrap();
+    let get = |path| s.route(&req("GET", path, json!({}), ""), 1);
+    let reply = get("/carlink-source/corresponding-source.tar.gz");
+    assert_eq!(reply.status, 200);
+    assert!(reply.body.is_empty(), "archive must not be buffered in response memory");
+    assert_eq!(reply.headers["Content-Type"], "application/gzip");
+    assert!(reply.headers["Content-Disposition"].contains("attachment"));
+    assert_eq!(get("/large.js").status, 404);
+    assert_eq!(get("/carlink-source/../large.js").status, 403);
+    assert_eq!(get("/carlink-source/%2e%2e/large.js").status, 403);
+    let mut remote = req("GET", "/carlink-source/corresponding-source.tar.gz", json!({}), "");
+    remote.peer = "8.8.8.8".parse().unwrap();
+    assert_eq!(s.route(&remote, 1).status, 403);
+}
