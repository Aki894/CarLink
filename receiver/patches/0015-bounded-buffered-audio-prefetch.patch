 #[test]
+fn buffered_prefetch_is_bounded_without_changing_playback_anchor() {
+    #[derive(Default)]
+    struct TimedAudio {
+        packets: Mutex<Vec<(Instant, u32)>>,
+        stops: AtomicUsize,
+    }
+    impl AudioListener for TimedAudio {
+        fn on_rtp(&self, _: &AudioFormat, _: &[u8], sample: u32) -> Result<()> {
+            self.packets.lock().unwrap().push((Instant::now(), sample));
+            Ok(())
+        }
+        fn on_stopped(&self) -> Result<()> {
+            self.stops.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        }
+    }
+    let t = Arc::new(Transport::default());
+    let o = Arc::new(TimedAudio::default());
+    let f = format();
+    assert_eq!(f.sample_rate, 48000);
+    let b = BufferedAudioStream::new(t.clone(), f, vec![4; 32], o.clone()).unwrap();
+    b.start().unwrap();
+    let socket = Arc::new(ByteStream::default());
+    t.server().connect(socket.clone());
+    let first = 1000;
+    let mut bytes = Vec::new();
+    for seq in 0..48u16 {
+        bytes.extend(buffered_packet(
+            &[4; 32], seq, first + u32::from(seq) * 1024, b"aac",
+        ));
+    }
+    let length = bytes.len();
+    socket.push(bytes);
+    wait(|| socket.consumed.load(Ordering::SeqCst) == length);
+    assert!(o.packets.lock().unwrap().is_empty());
+    let now = (2_208_988_800u64 + 100) << 32;
+    let epoch = Instant::now();
+    let anchor = b.set_rate(Some(first), 1, now).unwrap();
+    assert_eq!(anchor, Some(BufferedAudioStream::anchor_plist(
+        first, now.wrapping_add(BufferedAudioStream::millis_to_ntp(400)), 1,
+    )));
+    wait(|| o.packets.lock().unwrap().len() == 48);
+    b.set_rate(None, 0, now).unwrap();
+    let captured = o.packets.lock().unwrap().clone();
+    for (index, (at, sample)) in captured.iter().enumerate() {
+        assert_eq!(*sample, first + index as u32 * 1024);
+        let sent_us = (index as i128 + 1) * 1024 * 1_000_000 / 48000;
+        let lead_us = sent_us - at.duration_since(epoch).as_micros() as i128;
+        // Include one AAC frame of threshold overshoot and scheduler margin.
+        assert!(lead_us <= 235_000, "packet {index}: prefetch lead {lead_us} us");
+    }
+    assert_eq!(o.stops.load(Ordering::SeqCst), 1);
+    // Pause, discard retained history, and start another epoch: no stale
+    // prefetched audio may leak through the bounded-feed change.
+    let resumed = 1_000_000;
+    b.flush(Some(resumed)).unwrap();
+    let resume_anchor = b.set_rate(Some(resumed), 1, now).unwrap();
+    assert_eq!(resume_anchor, Some(BufferedAudioStream::anchor_plist(
+        resumed, now.wrapping_add(BufferedAudioStream::millis_to_ntp(400)), 1,
+    )));
+    let mut next = Vec::new();
+    for seq in 48..52u16 {
+        next.extend(buffered_packet(
+            &[4; 32], seq, resumed + u32::from(seq - 48) * 1024, b"aac",
+        ));
+    }
+    socket.push(next);
+    wait(|| o.packets.lock().unwrap().len() == 52);
+    assert_eq!(o.packets.lock().unwrap()[48..].iter().map(|(_, ts)| *ts).collect::<Vec<_>>(),
+        [resumed, resumed + 1024, resumed + 2048, resumed + 3072]);
+    b.close().unwrap();
+}
