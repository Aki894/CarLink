+#[cfg(test)]
+mod carlink_host_ui_tests {
+    use super::*;
+    #[test]
+    fn carlink_host_ui_is_negotiated_ephemeral_and_preserves_session() {
+        let input = DiPlayInput::new(Arc::new(JsonEvents::new(Arc::new(|_| {}))));
+        let (tx, rx) = sync_channel(8);
+        { let mut s = input.state.lock().unwrap(); s.output = Some(tx); s.active = true; }
+        input.carlink_host_ui_requested(); assert!(rx.try_recv().is_err());
+        let hello = |client| Message::Json(serde_json::json!({"type":"hello","version":0,"role":"consumer","name":"test","client":client}));
+        input.control(&hello("carlink-live-rust;carlink-host-ui=1")).unwrap();
+        input.carlink_host_ui_requested();
+        let event = rx.try_recv().unwrap();
+        assert!(matches!(event, Message::Json(v) if v["type"] == "host-ui-request"));
+        { let s = input.state.lock().unwrap(); assert!(s.active); assert!(!s.declarations.contains_key("")); }
+        input.control(&hello("legacy-web")).unwrap();
+        input.carlink_host_ui_requested(); assert!(rx.try_recv().is_err());
+        input.control(&hello("carlink-live-rust;carlink-host-ui=1")).unwrap();
+        input.state.lock().unwrap().active = false;
+        input.carlink_host_ui_requested(); assert!(rx.try_recv().is_err());
+    }
+}
