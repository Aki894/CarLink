+#[cfg(test)]
+mod carlink_production_key_tests {
+    use super::*;
+    struct Control(std::sync::mpsc::Sender<(u16,bool)>);
+    impl SessionControl for Control {
+        fn send_touch(&self, _: &[AirPlayContact]) -> Result<bool> { Ok(true) }
+        fn send_key(&self, key: u16, down: bool) -> Result<bool> {
+            self.0.send((key,down)).unwrap(); Ok(true)
+        }
+    }
+    fn input() -> DiPlayInput {
+        DiPlayInput::new(Arc::new(JsonEvents::new(Arc::new(|_| {}))))
+    }
+    #[test]
+    fn carlink_production_controls_receive_keys_without_replay_callback() {
+        let input = input();
+        assert!(!input.key(1,true).unwrap());
+        let (tx,rx) = std::sync::mpsc::channel();
+        let id = input.begin(Arc::new(Control(tx))).unwrap();
+        assert!(input.state.lock().unwrap().keys.is_none());
+        for key in 0..=10 {
+            assert!(input.key(key,true).unwrap());
+            assert_eq!(rx.recv_timeout(Duration::from_secs(2)).unwrap(), (key,true));
+            assert!(input.key(key,false).unwrap());
+        }
+        assert!(rx.try_recv().is_err());
+        assert!(!input.key(11,true).unwrap());
+        input.end(id).unwrap(); assert!(!input.key(1,true).unwrap());
+    }
+    #[test]
+    fn carlink_key_queue_is_bounded_and_old_session_commands_are_retired() {
+        let mut input = input();
+        let (queue,queued) = sync_channel(1); input.recovery = queue;
+        let (first,old_keys) = std::sync::mpsc::channel();
+        let old = input.begin(Arc::new(Control(first))).unwrap();
+        assert!(input.key(1,true).unwrap());
+        assert!(!input.key(2,true).unwrap());
+        let command = queued.recv().unwrap();
+        input.end(old).unwrap();
+        let (next,new_keys) = std::sync::mpsc::channel();
+        let current = input.begin(Arc::new(Control(next))).unwrap();
+        let InputCommand::Key(id,key,down) = command else { panic!("wrong queued command") };
+        assert_eq!(id,old);
+        assert!(!DiPlayInput::forward_key(&input.state,id,key,down));
+        assert!(old_keys.try_recv().is_err()); assert!(new_keys.try_recv().is_err());
+        assert!(DiPlayInput::forward_key(&input.state,current,1,true));
+        assert_eq!(new_keys.recv_timeout(Duration::from_secs(1)).unwrap(), (1,true));
+        input.end(current).unwrap();
+    }
