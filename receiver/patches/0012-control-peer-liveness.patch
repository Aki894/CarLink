+#[cfg(all(test, target_os = "linux"))]
+mod carlink_control_liveness_tests {
+    use super::*;
+    fn pair() -> (TcpStream, TcpStream) {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let local = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (peer, _) = listener.accept().unwrap();
+        (local, peer)
+    }
+    fn option(socket: &TcpStream, level: i32, name: i32) -> i32 {
+        let mut value = 0i32;
+        let mut len = std::mem::size_of::<i32>() as libc::socklen_t;
+        let result = unsafe {
+            libc::getsockopt(socket.as_raw_fd(), level, name,
+                &mut value as *mut _ as *mut libc::c_void, &mut len)
+        };
+        assert_eq!(result, 0);
+        assert_eq!(len as usize, std::mem::size_of::<i32>());
+        value
+    }
+    #[test]
+    fn carlink_control_socket_uses_bounded_peer_health_without_changing_media_defaults() {
+        let (socket, _peer) = pair();
+        configure_peer_liveness(&socket).unwrap();
+        let control = TcpDuplex::control(socket).unwrap();
+        for (level, name, expected) in [
+            (libc::SOL_SOCKET, libc::SO_KEEPALIVE, 1),
+            (libc::IPPROTO_TCP, libc::TCP_KEEPIDLE, 3),
+            (libc::IPPROTO_TCP, libc::TCP_KEEPINTVL, 1),
+            (libc::IPPROTO_TCP, libc::TCP_KEEPCNT, 3),
+            (libc::IPPROTO_TCP, libc::TCP_USER_TIMEOUT, 6_000),
+        ] { assert_eq!(option(&control.socket, level, name), expected); }
+        assert_eq!(control.socket.write_timeout().unwrap(), Some(Duration::from_secs(3)));
+        let (socket, _peer) = pair();
+        let media = TcpDuplex::new(socket).unwrap();
+        assert_eq!(media.write_timeout, Duration::from_secs(10));
+        assert_eq!(option(&media.socket, libc::SOL_SOCKET, libc::SO_KEEPALIVE), 0);
+    }
+    #[test]
+    fn carlink_static_session_survives_peer_health_deadline_without_media_frames() {
+        let (socket, mut peer) = pair();
+        configure_peer_liveness(&socket).unwrap();
+        let control = TcpDuplex::control(socket).unwrap();
+        let until = Instant::now() + Duration::from_millis(6500);
+        // No RTSP, media packets, sleeps, or application keepalives. The peer's
+        // kernel acknowledges TCP probes, as a healthy static CarPlay screen does.
+        while Instant::now() < until {
+            assert!(matches!(control.recv(1, Duration::from_millis(100)).unwrap(), Receive::Timeout));
+            assert!(!control.closed.load(Ordering::Acquire));
+        }
+        peer.write_all(b"x").unwrap();
+        assert!(matches!(control.recv(1, Duration::from_secs(1)).unwrap(), Receive::Data(data) if data.as_slice() == b"x"));
+        control.close().unwrap();
+        assert!(matches!(control.recv(1, Duration::from_millis(1)).unwrap(), Receive::Eof));
+    }
+}
