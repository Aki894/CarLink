+
+#[test]
+fn telephony_offer_excludes_entertainment_rates() {
+    let mut c = config();
+    for opus in [true, false] {
+        c.output_opus = opus;
+        c.microphone_opus = opus;
+        let f = format(&c, 100, "telephony");
+        let expected = 0x150 | if opus { 0x30000000 } else { 0 };
+        assert_eq!(uint(&f, "audioOutputFormats"), expected);
+        assert_eq!(uint(&f, "audioInputFormats"), expected);
+    }
+    c.microphone = false;
+    assert!(format(&c, 100, "telephony").get("audioInputFormats").is_none());
+}
