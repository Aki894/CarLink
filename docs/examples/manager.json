{
  "schema": 1,
  "socket": "/run/carlink-manager/control.sock",
  "live_socket": "/run/carlink/live.sock",
  "state": "/var/lib/carlink/manager/devices.json",
  "carlife": [
    "/usr/local/bin/carlink",
    "carlife",
    "usb",
    "--duration",
    "0",
    "--live-socket",
    "/run/carlink/live.sock"
  ],
  "carplay": [
    "/usr/local/bin/carlink-carplay",
    "forward"
  ],
  "hicar": [
    "/usr/local/bin/carlink",
    "hicar",
    "run",
    "--model",
    "00040A00",
    "--duration",
    "0",
    "--tx-power",
    "11",
    "--auth-library",
    "/usr/local/lib/carlink/hicar-native/libcarlink_hichain.so",
    "--identity",
    "/var/lib/carlink/hicar/production/identity.json",
    "--auth-store",
    "/var/lib/carlink/hicar/production/keys",
    "--network-interface",
    "auto",
    "--managed",
    "--live-socket",
    "/run/carlink/live.sock",
    "--audio-binary",
    "/usr/local/lib/carlink/carplay/bin/carlink-audio"
  ],
  "devices": [],
  "initial": "carplay",
  "connect_seconds": 30,
  "stable_seconds": 10,
  "pair_seconds": 120,
  "web_listen": "0.0.0.0:8088",
  "source_socket": "/run/carlink-manager/source.sock",
  "menu_library": "/usr/local/lib/carlink/carplay/lib/libcarlink_menu.so",
  "menu_font": "/usr/local/lib/carlink/carplay/share/fonts/NotoSansCJKsc-Regular.otf"
}
